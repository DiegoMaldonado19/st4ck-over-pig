// Clase padre del enunciado. imprimirCopias() llama a imprimir() sobre su
// propio objeto: tambien ahi responde la version de la clase del objeto.
class Impresora {
    public void imprimir() {
        println("Imprimiendo documento genérico...");
    }

    public void imprimirCopias(int copias) {
        for (int i = 1; i <= copias; i++) {
            print("Copia " + i + ": ");
            this.imprimir();
        }
    }

    public String estado() {
        return "lista";
    }
}
