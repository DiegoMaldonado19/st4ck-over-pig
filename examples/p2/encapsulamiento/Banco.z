// Otra clase: usa solo lo public de Cuenta (atributos, metodos y
// constructores). Lo private, lo protected y lo default lo intenta Intruso.z.
public class Banco {
    Cuenta principal;

    public Banco(Cuenta cuenta) {
        principal = cuenta;
    }

    public void reporte() {
        principal.depositar(100);
        principal.cerrarMes();
        println("Banco: " + principal.titular + " tiene " + principal.getSaldo());
        Cuenta socia = new Cuenta("Ana", 50, 4321);
        Cuenta nueva = principal.abrir("Luis");
        println("Banco: " + nueva.titular + " " + nueva.getSaldo() + " " + socia.mismoPin(principal));
    }
}
