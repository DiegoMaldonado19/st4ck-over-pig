// Clase hija: usa lo public y lo protected de Cuenta (atributos, metodos y
// constructores, estos con super). Lo private y lo default lo intenta
// CuentaEspia.z.
public class CuentaAhorro extends Cuenta {
    public CuentaAhorro(int saldoInicial) {
        super(saldoInicial);
        titular = "Ahorro";
        tasa = 20;
    }

    public CuentaAhorro(String titularInicial) {
        super(titularInicial, 0, 0);
    }

    public int capitalizar() {
        cerrarMes();
        return getSaldo() + interes();
    }
}
