// Clase hija que intenta usar lo private y lo default de Cuenta: sus
// constructores y cada linea de espiar son un error (cabecera de errores.pig).
public class CuentaEspia extends Cuenta {
    public CuentaEspia() {
        super();
    }

    public void espiar() {
        int robado = pin;
        pin = 0;
        boolean ok = validarPin(1234);
        boolean otra = this.validarPin(robado);
        saldo = 5;
        abonarInteres();
    }

    public CuentaEspia(String titularInicial) {
        super(titularInicial);
    }
}
