// Clase hija que intenta usar lo private de Cuenta: su constructor y cada
// linea de espiar son un error (la lista esta en la cabecera de errores.pig).
public class CuentaEspia extends Cuenta {
    public CuentaEspia() {
        super();
    }

    public void espiar() {
        int robado = pin;
        pin = 0;
        boolean ok = validarPin(1234);
        boolean otra = this.validarPin(robado);
    }
}
