// Otra clase que intenta usar lo private y lo protected de Cuenta: cada
// linea de espiar es un error (la lista esta en la cabecera de errores.pig).
public class Intruso {
    public void espiar(Cuenta cuenta) {
        int pin = cuenta.pin;
        cuenta.tasa = 99;
        boolean ok = cuenta.validarPin(0);
        int extra = cuenta.interes();
        Cuenta vacia = new Cuenta();
        Cuenta interna = new Cuenta(5);
    }
}
