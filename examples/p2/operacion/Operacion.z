// id y valorBase son public: el main del parcial vive dentro de la clase y aqui
// vive en el .pig, y sin modificador serian como private (auxiliar, 22-oct).
public class Operacion {
    public int id;
    public int valorBase;

    public int sumar(int n) {
        if (n <= 0) {
            return this.valorBase;
        } else {
            int total = n + sumar(n - 1);
            return total;
        }
    }
}
