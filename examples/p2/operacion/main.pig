// El ejemplo de clase (docs/Ejemplo.txt): la clase Operacion con su metodo
// recursivo sumar, y el main de Java llevado a MAIOR.
// Imprime "resultado = 13": sumar(2) = 2 + 1 + valorBase.
import Operacion.z

VARIABILES>
esto obj : novus Operacion();
esto resultado : numerus 0;

MAIOR>
obj.id = 1;
obj.valorBase = 10;
resultado = obj.sumar(2);
>> "resultado = " >> resultado;
FINIS;
