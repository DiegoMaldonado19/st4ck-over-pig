##
    Hola Mundo integrando los tres lenguajes
##
import Saludo.y
import Hola.z

VARIABILES>
esto objeto : novus Hola();
esto nombre : textum "Cadete";

MAIOR>
>> "Hola Mundo desde Pig Latin" ;
saludar();
saludarA(nombre);
objeto.decir();
>> "2 + 3 = " >> sumar(2, 3) ;
>> "El doble de 21 es " >> objeto.doble(21) ;
FINIS;
